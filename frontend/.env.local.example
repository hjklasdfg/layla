# Copy to .env.local:  cp .env.local.example .env.local

# ─── TfL Unified API (server-only — never NEXT_PUBLIC_) ─────────────────────
# Register at https://api-portal.tfl.gov.uk/
TFL_APP_KEY=your_tfl_primary_key_here
TFL_APP_ID=

# ─── Layla backend ───────────────────────────────────────────────────────────
# Your backend base URL, e.g. http://localhost:8000
BACKEND_API_URL=
BACKEND_API_KEY=

# LLM provider: gemini | nemotron | backend
LLM_PROVIDER=gemini
NEXT_PUBLIC_LLM_PROVIDER=gemini

# ─── Nemotron inference (OpenAI-compatible vLLM) — mobility planning ───────
NEMOTRON_BASE_URL=https://theory-refresh-soma-provisions.trycloudflare.com
NEMOTRON_MODEL=nvidia/Nemotron-3-Nano-Omni-30B-A3B-Reasoning-NVFP4
# NEMOTRON_API_KEY=

# ─── Google Gemini (optional — mobility/other features) ──────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash

# ─── Nebius AI — hazard report agent (required for Report hazard button) ─────
# Get a key at https://studio.nebius.ai/
NEBUISAI_API_KEY=your_nebius_api_key_here
# NEBUISAI_BASE_URL=https://api.tokenfactory.nebius.com/v1
# NEBUISAI_MODEL=Qwen/Qwen3-32B
# NEBUISAI_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
# Optional: Tavily search — better web results than DuckDuckGo fallback
# TAVILY_API_KEY=

# Optional: auto-send hazard report emails via Resend (https://resend.com)
# RESEND_API_KEY=
# HAZARD_REPORT_FROM_EMAIL=Layla <reports@yourdomain.com>

# ─── ElevenLabs voice (Scribe STT + TTS) ─────────────────────────────────────
# Tap mic to start/stop speech input; Layla TTS reads plan results aloud.
# TTS speaks plan voiceText after planning (POST /api/voice/speak).
ELEVENLABS_API_KEY=
NEXT_PUBLIC_VOICE_ENABLED=true
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Legacy — not required for Scribe mode (only if you still use ConvAI agent elsewhere)
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# ─── Backend mobility contract ───────────────────────────────────────────────
# Next.js sends raw TfL candidates + sensors; backend enriches OSM and returns
# path options + explanation (uiText for panel, voiceText for voice guide).
# POST {BACKEND_API_URL}/mobility/plan
