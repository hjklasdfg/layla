# Copy to .env.local:  cp .env.local.example .env.local

# ─── TfL Unified API (server-only — never NEXT_PUBLIC_) ─────────────────────
# Register at https://api-portal.tfl.gov.uk/
TFL_APP_KEY=your_tfl_primary_key_here
TFL_APP_ID=

# ─── Google Gemini (server-only) ─────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ─── LLM provider: mock | gemini ─────────────────────────────────────────────
LLM_PROVIDER=gemini
NEXT_PUBLIC_LLM_PROVIDER=gemini

# ─── ElevenLabs Conversational AI ─────────────────────────────────────────────
# Server-side: used for HMAC signature verification
ELEVENLABS_API_KEY=
# Client-side: ElevenLabs agent ID (safe to expose)
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# ─── NemoClaw Inference Endpoint ──────────────────────────────────────────────
# Port-forwarded after: nemoclaw <sandbox> start
NEMOCLAW_INFERENCE_URL=http://localhost:18789/v1
NEMOCLAW_API_KEY=
NEMOCLAW_MODEL=nvidia/nemotron-3-super-120b-a12b

# ─── Voice Memory Storage ─────────────────────────────────────────────────────
VOICE_MEMORY_DIR=./data/voice
