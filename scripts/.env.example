NEBIUS_API_KEY=your_nebius_api_key_here

# Cloudflare API token (needs Cloudflare Tunnel + DNS Edit permissions)
 CLOUDFLARE_API_TOKEN=

# Named tunnel — set by setup-named-tunnel.sh
 TUNNEL_NAME=layla-hackathon
 TUNNEL_HOSTNAME=layla.ai-cloud.io
 GATEWAY_URL=https://layla.ai-cloud.io

# Caddy reverse proxy auth
# Generate hash: docker run --rm caddy:alpine caddy hash-password --plaintext 'yourpassword'
 CADDY_USER=layla
 CADDY_HASHED_PASSWORD=
